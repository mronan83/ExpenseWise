# ExpenseWise environment variables. Copy to .env.local for development; set real values in
# Vercel project settings. Never commit real values. See docs/adr/0013-supabase-platform.md.

# --- Supabase (Auth, Postgres, Storage) ---------------------------------------------------
# Project URL, e.g. https://abcd1234.supabase.co. The API verifies access tokens against
# <url>/auth/v1/.well-known/jwks.json, so no JWT secret is needed anywhere.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…): safe in the browser and the iOS app, used for sign-in only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): server only. Signs Storage upload/download URLs. Bypasses RLS.
SUPABASE_SECRET_KEY=

# --- Database ------------------------------------------------------------------------------
# Runtime connection: the expensewise_app role through the shared pooler in transaction mode.
# Leave out sslmode: Supabase hosts always get TLS verified against Supabase's root CA.
#   postgresql://expensewise_app.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:6543/postgres
# The API refuses to start tenant work on a role that bypasses row-level security.
# Do NOT use the integration's POSTGRES_URL here: it is the postgres role, which has BYPASSRLS.
DATABASE_URL=
# Migrations only (the postgres role, session pooler on 5432). Never available to the app runtime.
DATABASE_MIGRATION_URL=

# --- Workflows (Inngest) -------------------------------------------------------------------
# Set by the Inngest Vercel integration. Without both, /api/inngest answers 503 and no
# workflow runs. For local development, run `npx inngest-cli dev` and set INNGEST_DEV=1.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=
# The outbox relay: the expensewise_relay role, which can only claim and mark outbox events.
#   postgresql://expensewise_relay.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:6543/postgres
RELAY_DATABASE_URL=

# --- Feature flags (PostHog) ----------------------------------------------------------------
# Project token (phc_…) and host. Without them every flag is off unless overridden below.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Beats PostHog: comma-separated flag=on|off, e.g. shell.build-version=on. The kill switch.
FLAG_OVERRIDES=

# --- Error tracking (Sentry) ----------------------------------------------------------------
# The DSN is public. Without it error tracking is off.
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build time only: uploads source maps so browser stack traces are readable.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- AI provider keys (ADR-0015) -----------------------------------------------------------
# Keys are entered in the app under Settings, never here. They are encrypted with a key derived
# from APP_ENCRYPTION_KEY when set, otherwise from SUPABASE_SECRET_KEY. Rotating that secret
# makes stored keys unreadable, and they are entered again.
APP_ENCRYPTION_KEY=
# The extraction spike (evals/) is a command-line tool, so it still reads this.
ANTHROPIC_API_KEY=
