# ExpenseWise environment variables. Copy to .env.local for development; set real values in
# Vercel project settings. Never commit real values. See docs/adr/0013-supabase-platform.md.

# --- Supabase (Auth, Postgres, Storage) ---------------------------------------------------
# Project URL, e.g. https://abcd1234.supabase.co. The API verifies access tokens against
# <url>/auth/v1/.well-known/jwks.json, so no JWT secret is needed anywhere.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…): safe in the browser and the iOS app, used for sign-in only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): server only. Signs Storage upload/download URLs. Bypasses RLS.
SUPABASE_SECRET_KEY=

# --- Database ------------------------------------------------------------------------------
# Runtime connection: the expensewise_app role through the shared pooler in transaction mode.
#   postgresql://expensewise_app.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:6543/postgres
# The API refuses to start tenant work on a role that bypasses row-level security.
# Do NOT use the integration's POSTGRES_URL here: it is the postgres role, which has BYPASSRLS.
DATABASE_URL=
# Migrations only (the postgres role, session pooler on 5432). Never available to the app runtime.
DATABASE_MIGRATION_URL=

# --- Later phases --------------------------------------------------------------------------
# Receipt extraction spike (ADR-0006).
ANTHROPIC_API_KEY=
# Durable workflows.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
