{
  "openapi": "3.1.0",
  "info": {
    "title": "ExpenseWise API",
    "version": "1.0.0",
    "description": "The API behind the ExpenseWise web and iOS apps. Money is always integer minor units plus an ISO 4217 code. Errors are RFC 9457 problem documents."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A Supabase Auth access token for a signed-in user."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string",
            "example": "3f9c2ab",
            "description": "Deployed commit, or \"dev\"."
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean",
            "description": "True when no check failed."
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "$ref": "#/components/schemas/ReadinessCheck"
              },
              "role": {
                "$ref": "#/components/schemas/ReadinessCheck"
              },
              "tls": {
                "$ref": "#/components/schemas/ReadinessCheck"
              },
              "tenantIsolation": {
                "$ref": "#/components/schemas/ReadinessCheck"
              }
            },
            "required": [
              "database",
              "role",
              "tls",
              "tenantIsolation"
            ]
          }
        },
        "required": [
          "ready",
          "checks"
        ]
      },
      "ReadinessCheck": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "skip"
            ]
          },
          "detail": {
            "type": "string",
            "example": "connected as expensewise_app"
          }
        },
        "required": [
          "status",
          "detail"
        ]
      },
      "Identity": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "example": "6f1d2c3e-8a4b-4f5e-9c7d-0a1b2c3d4e5f"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "example": "alex@example.com"
          },
          "assuranceLevel": {
            "type": "string",
            "enum": [
              "aal1",
              "aal2"
            ],
            "description": "aal2 means this session passed multi-factor authentication."
          },
          "sessionId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "userId",
          "email",
          "assuranceLevel",
          "sessionId"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://expensewise.dev/problems/not-found"
          },
          "title": {
            "type": "string",
            "example": "Not found"
          },
          "status": {
            "type": "integer",
            "example": 404
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code."
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "organization": {
            "$ref": "#/components/schemas/Organization"
          },
          "member": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "role": {
                "type": "string",
                "enum": [
                  "member",
                  "approver",
                  "finance_admin",
                  "owner",
                  "auditor"
                ]
              }
            },
            "required": [
              "id",
              "role"
            ]
          }
        },
        "required": [
          "organization",
          "member"
        ]
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "alex's organization"
          },
          "homeCurrency": {
            "type": "string",
            "example": "USD"
          }
        },
        "required": [
          "id",
          "name",
          "homeCurrency"
        ]
      },
      "AiProviderKeyList": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AiProviderKeyStatus"
            }
          }
        },
        "required": [
          "providers"
        ]
      },
      "AiProviderKeyStatus": {
        "type": "object",
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/AiProvider"
          },
          "configured": {
            "type": "boolean"
          },
          "keyHint": {
            "type": [
              "string",
              "null"
            ],
            "example": "gAAA",
            "description": "The last four characters of the stored key."
          },
          "authScheme": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "api_key",
              "bearer",
              null
            ],
            "description": "How the provider accepted the key: as an API key header or a bearer token."
          },
          "verifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "provider",
          "configured",
          "keyHint",
          "authScheme",
          "verifiedAt",
          "updatedAt"
        ]
      },
      "AiProvider": {
        "type": "string",
        "enum": [
          "anthropic",
          "openai"
        ]
      },
      "SetAiProviderKey": {
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1000,
            "description": "The key from the provider. It is checked with the provider, then stored encrypted and never returned."
          }
        },
        "required": [
          "apiKey"
        ]
      },
      "AiProviderKeyTest": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/AiProviderKeyStatus"
          },
          "reason": {
            "type": "string",
            "enum": [
              "rejected",
              "unreachable",
              "unreadable"
            ],
            "description": "Why the key could not be used, when valid is false."
          }
        },
        "required": [
          "valid",
          "status"
        ]
      },
      "SignInList": {
        "type": "object",
        "properties": {
          "signIns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignIn"
            }
          }
        },
        "required": [
          "signIns"
        ]
      },
      "SignIn": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "alex@example.com"
          },
          "linkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "current": {
            "type": "boolean",
            "description": "Whether this is the sign-in making the request."
          }
        },
        "required": [
          "id",
          "email",
          "linkedAt",
          "current"
        ]
      },
      "LinkSignIn": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 20,
            "maxLength": 8000,
            "description": "An access token for the other sign-in, from signing in with it moments ago. With the request's own token it proves the caller controls both. Used once, never stored."
          }
        },
        "required": [
          "accessToken"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Liveness check",
        "description": "Returns 200 while the API can serve requests. Does not touch the database.",
        "responses": {
          "200": {
            "description": "The API is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Readiness check",
        "description": "Connects to the database the way tenant requests do and checks what tenant isolation depends on: the runtime role, verified TLS and enforced row-level security. Results are cached for a few seconds. Details are fixed messages, never raw errors.",
        "responses": {
          "200": {
            "description": "Ready to serve tenant data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Not ready; at least one check failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "The signed-in user",
        "description": "Returns the identity proven by the access token. Organization memberships join this response in Phase 1.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The caller is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "401": {
            "description": "No token, or the token is invalid or expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in is not configured on this server.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/organization": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "The caller's organization, created on first sign-in",
        "description": "Returns the organization the signed-in user belongs to. On first sign-in it creates a one-person organization with the user as owner. Safe to call on every sign-in.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The existing organization.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "201": {
            "description": "A new organization was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The account has no email address.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in or the database is not configured on this server.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/settings/ai-providers": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "AI provider keys",
        "description": "Which AI providers have a key, the key's last four characters and when it last worked. Keys themselves are never returned.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "One entry per supported provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiProviderKeyList"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Only an owner or finance admin can manage AI provider keys.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in, the database or encryption is not configured on this server.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/settings/ai-providers/{provider}": {
      "put": {
        "tags": [
          "Settings"
        ],
        "summary": "Set the key for an AI provider",
        "description": "Checks the key with the provider (listing models, which costs nothing), then stores it encrypted, replacing any earlier key. The change is recorded in the audit log.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/AiProvider"
            },
            "required": true,
            "name": "provider",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetAiProviderKey"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The key works and is stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiProviderKeyStatus"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Only an owner or finance admin can manage AI provider keys.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The provider rejected the key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "The provider could not be reached; nothing was stored.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in, the database or encryption is not configured on this server.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Settings"
        ],
        "summary": "Remove the key for an AI provider",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/AiProvider"
            },
            "required": true,
            "name": "provider",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The key is removed."
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Only an owner or finance admin can manage AI provider keys.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No key is stored for this provider.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in or the database is not configured on this server.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/settings/ai-providers/{provider}/test": {
      "post": {
        "tags": [
          "Settings"
        ],
        "summary": "Check that a stored key still works",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/AiProvider"
            },
            "required": true,
            "name": "provider",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The result of a free call to the provider with the stored key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiProviderKeyTest"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Only an owner or finance admin can manage AI provider keys.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No key is stored for this provider.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in, the database or encryption is not configured on this server.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/sign-ins": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "The ways the caller signs in",
        "description": "Every sign-in (email) that reaches the same person in this organization. Each one sees the same receipts, expenses and settings.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The caller's sign-ins, oldest first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInList"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The caller has no organization yet: call POST /v1/me/organization first.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in or the database is not configured on this server.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Add another sign-in for the same person",
        "description": "Links a second sign-in, such as a work email, to the caller. The body carries an access token for that sign-in, so the caller proves control of both. If the other sign-in had created its own organization and left it empty, it moves; otherwise nothing changes.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkSignIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The sign-in was already linked to the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignIn"
                }
              }
            }
          },
          "201": {
            "description": "The sign-in now reaches the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignIn"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The caller has no organization yet: call POST /v1/me/organization first.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The other sign-in belongs to someone else here, or has its own organization with work in it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The token is not a valid, recent sign-in with an email address, or it is the caller.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in or the database is not configured on this server.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/sign-ins/{signInId}": {
      "delete": {
        "tags": [
          "Identity"
        ],
        "summary": "Remove one of the caller’s sign-ins",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "signInId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The sign-in no longer reaches this organization."
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
