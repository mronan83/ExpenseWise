    "@expensewise/extraction": "workspace:*",
    "@expensewise/flags": "workspace:*",
    "@expensewise/storage": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
