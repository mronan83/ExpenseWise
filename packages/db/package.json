{
  "name": "@expensewise/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "test:integration": "vitest run",
    "contract:check": "bash scripts/check-schema-drift.sh",
    "test": "vitest run --config vitest.unit.config.ts",
    "roles:set-passwords": "tsx src/set-role-passwords.ts"
  },
  "dependencies": {
    "@expensewise/domain": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
