{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^typecheck"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "contract:check": {},
    "@expensewise/api#test": {
      "outputs": []
    },
    "@expensewise/records#test": {
      "cache": false
    }
  }
}
