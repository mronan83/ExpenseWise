{
  "name": "expensewise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "contract:check": "turbo run contract:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "bash scripts/dev-postgres.sh start",
    "db:down": "bash scripts/dev-postgres.sh stop",
    "db:migrate": "pnpm --filter @expensewise/db migrate",
    "db:snapshot": "pnpm --filter @expensewise/db snapshot",
    "records:pages": "pnpm --filter @expensewise/records pages"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
